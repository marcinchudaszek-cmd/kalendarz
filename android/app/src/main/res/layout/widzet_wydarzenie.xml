<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widzet_wydarzenie"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/widzet_wydarzenie_kolor"
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widzet_pasek" />

    <TextView
        android:id="@+id/widzet_wydarzenie_czas"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="2"
        android:textColor="@color/widzet_tekst_drugi"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widzet_wydarzenie_tytul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widzet_tekst"
        android:textSize="14sp" />
</LinearLayout>
